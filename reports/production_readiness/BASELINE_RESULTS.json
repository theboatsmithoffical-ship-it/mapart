   "id": "F-01",
   "severity": "P0",
   "area": "palette accuracy",
   "title": "Palette base colors are unverified approximations",
   "evidence": "assets/mc_palettes.json _meta.verification_status = 'approximation'; survival-wool white 221,221,221 vs published 1.8.9 MapColor 255,255,255; magenta 219,111,183 vs 178,76,216; docs/engineering_report_v2.md section 11 already flags contradictions",
   "impact": "preview, quality metrics and exports can be internally consistent yet wrong in-game",
   "status": "open (Milestone 1)"
  },
  {
   "id": "F-02",
   "severity": "P0",
   "area": "palette data / version compatibility",
   "title": "Palette maps blocks to inconsistent or unavailable map colors",
   "evidence": "map-full-approx-1.15 maps map_color 18 rgb [140,224,231] and 20 rgb [255,181,170] both to minecraft:red_sand; ids 58/59 use minecraft:warped_wart_block, a 1.16 block, in a version labeled target_mc_version 1.15.2",
   "impact": "exported blocks cannot render the intended color; warped_wart_block does not exist in the declared target",
   "status": "open (Milestones 1-2)"
  },
  {
   "id": "F-03",
   "severity": "P0",
   "area": "construction feasibility",
   "title": "Default frame construction exports floating gravity blocks",
   "evidence": "probe_export.json: map-full-approx-1.15 frame has 1439 sand/red_sand with air directly below; solid mode 0; Settings.construction defaults to frame",
   "impact": "the exported volume collapses when built; structural validators accept it",
   "status": "open (Milestone 2)"
  },
  {
   "id": "F-04",
   "severity": "P0",
   "area": "fidelity / construction solver",
   "title": "Infeasible staircase pixels are exported without a gate",
   "evidence": "probe_export.json: map-full frame 3447/16384 infeasible (21.04%), 3444 intended-vs-realized shade mismatches; survival 2/16384; Settings.strict_geometry is accepted but never read",
   "impact": "up to a fifth of the image renders a different shade than requested; delivery proceeds with only a report counter",
   "status": "open (Milestones 1-2)"
  },
  {
   "id": "F-05",
   "severity": "P0",
   "area": "authoritative validation",
   "title": "No real renderer / client validation exists",
   "evidence": "tools/audit_palette_accuracy.py exits 2 (no simulator configured); tools/validate_render_against_mapart.py requires MAPART_SIMULATOR; no client integration in repo",
   "impact": "no in-game color or map-render claim is currently supported",
   "status": "blocked (external), documented"
  },
  {
   "id": "F-06",
   "severity": "P1",
   "area": "export validation",
   "title": "Validation is structural only, not geometry agreement",
   "evidence": "schem.validate_schem checks sizes/palette prefix/block count; validate_litematic checks size/volume/non-air; full_build compares only schem block count, no block-for-block compare, no litematic count compare, no block-state properties",
   "impact": "a structurally valid file can differ from the planned construction or be unbuildable",
   "status": "open (Milestone 2)"
  },
  {
   "id": "F-07",
   "severity": "P1",
   "area": "version metadata",
   "title": "No version manifest; export DataVersion is hardcoded",
   "evidence": "schem.DATA_VERSION = 2578 used for every palette; litematic writes MinecraftDataVersion 2578 even for survival-wool-1.8; no manifest file ties Minecraft version, litematic version, palette revision and model version together",
   "impact": "consumers cannot tell which game/format a file targets; 1.8 exports carry 1.15.2 metadata",
   "status": "open (Milestone 1)"
  },
  {
   "id": "F-08",
   "severity": "P1",
   "area": "block states",
   "title": "Only block names are serialized",
